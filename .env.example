# LawBey Railway (Open WebUI) instance
OPENWEBUI_BASE_URL=https://lawbey-railway-production.up.railway.app
OPENWEBUI_API_KEY=sk-replace-with-real-openwebui-api-key
OPENWEBUI_MODEL_ID=gpt-4o-mini-2024-07-18
OPENWEBUI_KB_ID=cda0f2ba-88d1-4c73-8a58-50d14180ba98

# Partner authentication (format: name:secret,name:secret)
# Generate with: python -c "import secrets; print('carta:' + secrets.token_urlsafe(32))"
PARTNER_API_KEYS=carta:REPLACE_WITH_RANDOM_SECRET

# Server config
LOG_LEVEL=INFO
PORT=8000

# Optional: tighten rate limits for testing (defaults: 100 per hour, 1000 per day)
# RATE_LIMIT_PER_HOUR=100
# RATE_LIMIT_PER_DAY=1000
